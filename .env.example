# --- AI ---------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Site -------------------------------------------------------------
# Override the canonical origin used in metadata, sitemap, robots, JSON-LD.
# NEXT_PUBLIC_SITE_URL="https://glzbearings.com"

# --- Search Console verification (optional) ---------------------------
# Get the value from Google Search Console → Settings → Ownership verification → HTML tag.
# Paste only the content="..." value.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# --- Analytics (optional, env-gated) ----------------------------------
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX"
# NEXT_PUBLIC_GA_ID=""
# Microsoft Clarity project ID, e.g. "abcd1234"
# NEXT_PUBLIC_CLARITY_ID=""

# --- Email (Resend) ---------------------------------------------------
# Get an API key at https://resend.com/api-keys
RESEND_API_KEY=""

# Verified sender. Until you verify a domain in Resend you can use the
# Resend sandbox sender: "GLZ Bearings <onboarding@resend.dev>".
# After verifying glzbearings.com (or a subdomain like mail.glzbearings.com)
# switch to: "GLZ Bearings <enquiries@mail.glzbearings.com>"
RESEND_FROM_EMAIL="GLZ Bearings <onboarding@resend.dev>"

# Where new enquiries land. Comma-separated for multiple recipients.
ENQUIRY_TO_EMAIL="engineering@glzbearings.com"

# Optional silent BCC (e.g. CRM intake, archive inbox). Comma-separated.
# ENQUIRY_BCC_EMAIL=""

# Reply-To used in the customer auto-reply email.
ENQUIRY_REPLY_TO="engineering@glzbearings.com"
