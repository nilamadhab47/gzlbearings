# --- AI ---------------------------------------------------------------
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# --- Site -------------------------------------------------------------
# Override the canonical origin used in metadata, sitemap, robots, JSON-LD.
# NEXT_PUBLIC_SITE_URL="https://glzbearings.com"

# --- Search Console verification (optional) ---------------------------
# Get the value from Google Search Console → Settings → Ownership verification → HTML tag.
# Paste only the content="..." value.
# NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=""
# NEXT_PUBLIC_BING_SITE_VERIFICATION=""

# --- Analytics (optional, env-gated) ----------------------------------
# Google Analytics 4 measurement ID, e.g. "G-XXXXXXXXXX"
# NEXT_PUBLIC_GA_ID=""
# Microsoft Clarity project ID, e.g. "abcd1234"
# NEXT_PUBLIC_CLARITY_ID=""
